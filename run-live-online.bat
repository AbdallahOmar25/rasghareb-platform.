@echo off
setlocal
cd /d "%~dp0"

echo ====================================================================
echo        بث منصة وتطبيقات رأس غارب أونلاين على الإنترنت (HTTPS)
echo ====================================================================
echo.

:: 1. تأكد من تشغيل السيرفر
netstat -ano | findstr /R /C:":3000 .*LISTENING" >nul
if errorlevel 1 (
    echo [1/2] جاري تشغيل سيرفر الموقع محلياً...
    start "Rasghareb Server" /min cmd.exe /c node server.js
    timeout /t 3 /nobreak >nul
) else (
    echo [1/2] السيرفر يعمل بالفعل على المنفذ 3000.
)

:: 2. تشغيل نفق Cloudflare المباشر
echo [2/2] جاري إنشاء رابط الدومين العالمي المشفر (Cloudflare HTTPS)...
echo.
echo ====================================================================
echo انتظر ثوانٍ وسيظهر لك رابط الدومين بالأسفل (https://...trycloudflare.com)
echo افتح هذا الرابط من هاتفك المحمول (أندرويد أو آيفون) لتجربة التطبيق!
echo (اترك هذه النافذة مفتوحة طالما تريد الموقع شغالاً للناس)
echo ====================================================================
echo.

.\cloudflared.exe tunnel --url http://localhost:3000

pause

