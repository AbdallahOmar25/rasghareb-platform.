<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3><i class="bi bi-shop"></i> <%= store.name %> - <%= t('store_dashboard') %></h3>
    <span class="badge bg-<%= store.status === 'approved' ? 'success' : (store.status === 'rejected' ? 'danger' : 'secondary') %>"><%= t('status_' + store.status) %></span>
  </div>

  <ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#products-tab"><%= t('manage_products') %></a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#settings-tab"><%= lang === 'ar' ? 'إعدادات المتجر' : 'Store Settings' %></a></li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="products-tab">
      <a href="/marketplace/new" class="btn btn-success btn-sm mb-3"><i class="bi bi-plus-lg"></i> <%= t('add_product') %></a>
      <div class="table-responsive">
        <table class="table table-striped align-middle">
          <thead><tr><th></th><th><%= lang === 'ar' ? 'المنتج' : 'Product' %></th><th><%= t('price') %></th><th><%= lang === 'ar' ? 'الحالة' : 'Status' %></th><th></th></tr></thead>
          <tbody>
            <% products.forEach(p => { %>
              <tr>
                <td><img src="<%= (p.images && p.images[0]) || '/img/placeholder.svg' %>" style="width:50px;height:50px;object-fit:cover" class="rounded" onerror="this.src='/img/placeholder.svg'"></td>
                <td><a href="/marketplace/<%= p.id %>"><%= p.title_ar %></a></td>
                <td><%= p.price %> <%= t('egp') %></td>
                <td><span class="badge bg-<%= p.status === 'approved' ? 'success' : (p.status === 'rejected' ? 'danger' : 'secondary') %>"><%= t('status_' + p.status) %></span></td>
                <td><a href="/marketplace/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary"><%= t('edit') %></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (!products.length) { %><p class="text-muted"><%= t('no_results') %></p><% } %>
      </div>
    </div>
    <div class="tab-pane fade" id="settings-tab">
      <form method="POST" enctype="multipart/form-data" action="/stores/<%= store.id %>/edit" style="max-width:600px">
        <div class="mb-3">
          <label class="form-label"><%= lang === 'ar' ? 'اسم المتجر' : 'Store name' %></label>
          <input type="text" name="name" class="form-control" value="<%= store.name %>" required>
        </div>
        <div class="mb-3">
          <label class="form-label"><%= t('description') %></label>
          <textarea name="description" class="form-control" rows="3"><%= store.description %></textarea>
        </div>
        <div class="row">
          <div class="col-6 mb-3">
            <label class="form-label"><%= t('phone') %></label>
            <input type="text" name="phone" class="form-control" value="<%= store.phone %>">
          </div>
          <div class="col-6 mb-3">
            <label class="form-label"><%= t('whatsapp') %></label>
            <input type="text" name="whatsapp" class="form-control" value="<%= store.whatsapp %>">
          </div>
        </div>
        <div class="row">
          <div class="col-6 mb-3">
            <label class="form-label"><%= lang === 'ar' ? 'الشعار' : 'Logo' %></label>
            <input type="file" name="logo" class="form-control" accept="image/*">
          </div>
          <div class="col-6 mb-3">
            <label class="form-label"><%= lang === 'ar' ? 'الغلاف' : 'Cover' %></label>
            <input type="file" name="cover" class="form-control" accept="image/*">
          </div>
        </div>
        <button class="btn btn-primary"><%= t('save') %></button>
      </form>
    </div>
  </div>
</div>
