<div class="container my-4">
  <div class="row g-4">
    <div class="col-md-6">
      <div id="carouselB" class="carousel slide border rounded overflow-hidden">
        <div class="carousel-inner">
          <% const imgs = (business.photos && business.photos.length) ? business.photos : ['/img/placeholder.svg']; %>
          <% imgs.forEach((img, i) => { %>
            <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
              <img src="<%= img %>" class="d-block w-100" style="max-height:380px;object-fit:cover" onerror="this.src='/img/placeholder.svg'">
            </div>
          <% }) %>
        </div>
        <% if (imgs.length > 1) { %>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselB" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselB" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
        <% } %>
      </div>
    </div>
    <div class="col-md-6">
      <h3><%= business.name %></h3>
      <span class="badge bg-<%= business.status === 'approved' ? 'success' : (business.status === 'rejected' ? 'danger' : 'secondary') %> mb-2"><%= t('status_' + business.status) %></span>
      <p><%= business.description %></p>
      <ul class="list-unstyled small">
        <% if (business.address) { %><li><i class="bi bi-geo-alt"></i> <strong><%= t('address') %>:</strong> <%= business.address %></li><% } %>
        <% if (business.openingHours) { %><li><i class="bi bi-clock"></i> <strong><%= t('opening_hours') %>:</strong> <%= business.openingHours %></li><% } %>
      </ul>
      <div class="d-flex gap-2 mt-3 flex-wrap">
        <% if (business.whatsapp) { %>
          <a class="btn btn-success btn-sm" target="_blank" href="https://wa.me/<%= business.whatsapp.replace(/[^0-9]/g,'') %>"><i class="bi bi-whatsapp"></i> <%= t('contact_whatsapp') %></a>
        <% } %>
        <% if (business.phone) { %>
          <a class="btn btn-outline-secondary btn-sm" href="tel:<%= business.phone %>"><i class="bi bi-telephone"></i> <%= t('contact_phone') %></a>
        <% } %>
        <% if (business.address) { %>
          <a class="btn btn-outline-primary btn-sm" target="_blank" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(business.address + ' Ras Ghareb') %>"><i class="bi bi-map"></i> <%= lang === 'ar' ? 'الموقع على الخريطة' : 'View on Map' %></a>
        <% } %>
      </div>
      <% const businessSocialLinks = (business.socialLinks || '').split(/[\n,]+/).map(s => s.trim()).filter(Boolean); %>
      <% if (businessSocialLinks.length) { %>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <% businessSocialLinks.forEach(link => { %>
            <% const href = /^https?:\/\//i.test(link) ? link : 'https://' + link; %>
            <% const label = /facebook/i.test(link) ? 'Facebook' : /instagram/i.test(link) ? 'Instagram' : /wa|whatsapp/i.test(link) ? 'WhatsApp' : (lang === 'ar' ? 'رابط' : 'Link'); %>
            <a class="btn btn-outline-dark btn-sm" href="<%= href %>" target="_blank" rel="noopener"><i class="bi bi-link-45deg"></i> <%= label %></a>
          <% }) %>
        </div>
      <% } %>
      <% if (currentUser && (currentUser.id === business.ownerId || ['primary_admin', 'secondary_admin', 'admin'].includes(currentUser.role))) { %>
        <div class="mt-3 d-flex gap-2">
          <a href="/businesses/<%= business.id %>/edit" class="btn btn-sm btn-outline-secondary"><%= t('edit') %></a>
          <form action="/businesses/<%= business.id %>/delete" method="POST" onsubmit="return confirm('<%= t('delete') %>?')">
            <button class="btn btn-sm btn-outline-danger"><%= t('delete') %></button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
  <%- include('../partials/reviews', { reviews, avgRating, targetType: 'business', targetId: business.id }) %>
</div>
