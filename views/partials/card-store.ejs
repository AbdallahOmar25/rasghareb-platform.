<div class="col-6 col-md-4 col-lg-3" data-reveal>
  <a href="/stores/<%= s.id %>" class="text-decoration-none">
    <div class="card listing-card h-100 text-center">
      <div class="pt-3">
        <img src="<%= s.logo || '/img/store-placeholder.svg' %>" onerror="this.src='/img/store-placeholder.svg'" class="avatar-img" alt="<%= s.name %>">
      </div>
      <div class="card-body">
        <h6 class="card-title mb-0"><%= s.name %></h6>
      </div>
    </div>
  </a>
</div>
