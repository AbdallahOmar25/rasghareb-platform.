<div class="col-6 col-md-4 col-lg-3" data-reveal>
  <a href="/professionals/<%= p.id %>" class="text-decoration-none">
    <div class="card listing-card h-100 text-center">
      <div class="pt-3">
        <img src="<%= p.photo || '/img/avatar-placeholder.svg' %>" onerror="this.src='/img/avatar-placeholder.svg'" class="avatar-img" alt="<%= p.name %>">
      </div>
      <div class="card-body">
        <h6 class="card-title mb-1"><%= p.name %></h6>
        <p class="card-text text-muted small mb-0"><%= lang === 'ar' ? p.profession_ar : (p.profession_en || p.profession_ar) %></p>
      </div>
    </div>
  </a>
</div>
