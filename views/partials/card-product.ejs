<div class="col-6 col-md-4 col-lg-3" data-reveal>
  <a href="/marketplace/<%= p.id %>" class="text-decoration-none">
    <div class="card listing-card h-100">
      <div class="card-img-wrap">
        <img src="<%= (p.images && p.images[0]) || '/img/placeholder.svg' %>" onerror="this.src='/img/placeholder.svg'" class="card-img-top" alt="<%= p.title_ar %>">
      </div>
      <div class="card-body">
        <h6 class="card-title text-truncate mb-1"><%= lang === 'ar' ? p.title_ar : (p.title_en || p.title_ar) %></h6>
        <p class="card-text fw-bold text-success mb-0"><%= p.price %> <%= t('egp') %></p>
      </div>
    </div>
  </a>
</div>
